// Common
@ROOT() {
  run();
}

@IF_NOT_NULL(<java.lang.Object> [ctx:local]) {
  if([ctx:local] != null) {
    run();
  }
}

@SCOPE(scope [ctx:scope]) {
  scope([ctx:scope]) {
    run();
  }
}

@EXIT_SCOPE(scope [ctx:scope]) {
  exit_scope([ctx:scope]);
}

@LIMITER(scope [ctx:scope], int [ctx:current], int [instr:limit]) {
  scope([ctx:scope]) {
    let [ctx:current] = [instr:limit];
    run();
  }
}

@CHECK_LIMIT(scope [ctx:scope], int [ctx:current]) {
  [ctx:current] = [ctx:current] - 1;
  if([ctx:current] == 0) {
    exit_scope([ctx:scope]);
  }
}

@CREATE_RESULT_STORAGE(int [ctx:storage]) {
  let [ctx:storage] = 0;
  run();
}

@ADD_RESULT_STORAGE(int [ctx:storage], int [ctx:value]) {
  [ctx:storage] = [ctx:storage] + [ctx:value];
}

@SET_RESULT_STORAGE(int [ctx:storage], int [ctx:value]) {
  [ctx:storage] = [ctx:value];
}

$for_each_list_indexed(<java.util.List> [ctx:list], yield<java.lang.Object> [ctx:element]) {
  let [local:index]<int> = 0;
  let [local:size]<int> = [ctx:list].size();
  while([local:index] < [local:size]) {
    yield([ctx:element], [ctx:list].get([local:index]));
    [local:index] = [local:index] + 1;
  }
}

$for_each_iterator(<java.util.Iterator> [ctx:iterator], yield<java.lang.Object> [ctx:element]) {
  while([ctx:iterator].hasNext() != false) {
    yield([ctx:element], [ctx:iterator].next());
  }
}

$for_each_iterable(<java.lang.Iterable> [ctx:iterable], yield<java.lang.Object> [ctx:element]) {
  let [local:iterator]<java.util.Iterator> = [ctx:iterable].iterator();
  while([local:iterator].hasNext() != false) {
    yield([ctx:element], [local:iterator].next());
  }
}

// Minecraft specific
@static_MINECRAFT_SERVER(<net.minecraft.commands.CommandSourceStack> [static:CommandSourceStack], <net.minecraft.server.MinecraftServer> [static:MinecraftServer]) {
  let [static:MinecraftServer] = [static:CommandSourceStack].getServer();
  run();
}

@static_PLAYER_LIST(<net.minecraft.server.MinecraftServer> [static:MinecraftServer], <net.minecraft.server.players.PlayerList> [static:PlayerList]) {
  let [static:PlayerList] = [static:MinecraftServer].getPlayerList();
  run();
}

@static_ALL_WORLDS(<net.minecraft.server.MinecraftServer> [static:MinecraftServer], <java.lang.Iterable> [static:AllWorlds]) {
  let [static:AllWorlds] = [static:MinecraftServer].getAllLevels();
  run();
}


// contract [ctx:entity] match IF_NOT_NULL remove
@GET_CURRENT_ENTITY(<net.minecraft.commands.CommandSourceStack> [static:CommandSourceStack], <net.minecraft.world.entity.Entity> [ctx:entity]) {
  let [ctx:entity] = [static:CommandSourceStack].getEntity();
  if([ctx:entity] != null) {
    run();
  }
}

@ADD_ENTITY_TAG(<net.minecraft.world.entity.Entity> [ctx:entity], <java.lang.String> [instr:tag]) {
  [ctx:entity].addTag([instr:tag]);
}

@REMOVE_ENTITY_TAG(<net.minecraft.world.entity.Entity> [ctx:entity], <java.lang.String> [instr:tag]) {
  [ctx:entity].removeTag([instr:tag]);
}

=CHECK_ENTITY_TAG(<net.minecraft.world.entity.Entity> [ctx:entity], <java.lang.String> [instr:tag], boolean [instr:negated]) {
  (negated == false) => CHECK_HAS_ENTITY_TAG;
  => CHECK_NOT_HAS_ENTITY_TAG;
}

@CHECK_HAS_ENTITY_TAG(<net.minecraft.world.entity.Entity> [ctx:entity], <java.lang.String> [instr:tag]) {
  if([ctx:entity].getTags().contains([instr:tag]) != false) {
    run();
  }
}

@CHECK_NOT_HAS_ENTITY_TAG(<net.minecraft.world.entity.Entity> [ctx:entity], <java.lang.String> [instr:tag]) {
  if([ctx:entity].getTags().contains([instr:tag]) == false) {
    run();
  }
}

=CHECK_ENTITY_TAGS(<net.minecraft.world.entity.Entity> [ctx:entity], boolean [instr:negated]) {
  (negated == false) => CHECK_HAS_ENTITY_TAGS;
  => CHECK_NOT_HAS_ENTITY_TAGS;
}

@CHECK_HAS_ENTITY_TAGS(<net.minecraft.world.entity.Entity> [ctx:entity]) {
  if([ctx:entity].getTags().size() != 0) {
    run();
  }
}

@CHECK_NOT_HAS_ENTITY_TAGS(<net.minecraft.world.entity.Entity> [ctx:entity]) {
  if([ctx:entity].getTags().size() == 0) {
    run();
  }
}

// contract [ctx:entity] match IF_NOT_NULL remove
@FOR_EACH_PLAYER(<net.minecraft.server.players.PlayerList> [static:PlayerList], <net.minecraft.server.level.ServerPlayer> [ctx:entity]) {
  let [local:players]<java.util.List> = [static:PlayerList].getPlayers();
  let [ctx:entity];
  for_each_list_indexed([local:players], [ctx:entity]) {
    run();
  }
}

// contract [ctx:entity] match IF_NOT_NULL remove
@FOR_EACH_ENTITY(<java.lang.Iterable> [static:AllWorlds], <net.minecraft.world.entity.Entity> [ctx:entity]) {
  let [local:world]<net.minecraft.server.level.ServerLevel>;
  for_each_iterable([static:AllWorlds], [local:world]) {
    let [local:entities]<java.lang.Iterable> = [local:world].getAllEntities();
    let [ctx:entity];
    for_each_iterable([local:entities], [ctx:entity]) {
      run();
    }
  }
}

@FOR_PLAYER(<net.minecraft.server.players.PlayerList> [static:PlayerList], <net.minecraft.server.level.ServerPlayer> [ctx:player], <java.lang.String> [instr:name]) {
  let [ctx:player] = [static:PlayerList].getPlayerByName([instr:name]);
  run();
}

// contract [ctx:entity] match IF_NOT_NULL remove
@FOR_ENTITY(<java.lang.Iterable> [static:AllWorlds], <net.minecraft.world.entity.Entity> [ctx:entity], <java.util.UUID> [instr:uuid]) {
  let [local:world]<net.minecraft.server.level.ServerLevel>;
  for_each_iterable([static:AllWorlds], [local:world]) {
    let [ctx:entity] = [local:world].getEntity([instr:uuid]);
    if([ctx:entity] != null) {
      run();
      return;
    }
  }
}