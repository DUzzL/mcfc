// Common
@ROOT() {
  run();
}

@IF_NOT_NULL(<java.lang.Object> [ctx:local]) {
  if([ctx:local] != null) {
    run();
  }
}

@SCOPE(scope [ctx:scope]) {
  scope([ctx:scope]) {
    run();
  }
}

@EXIT_SCOPE(scope [ctx:scope]) {
  exit_scope([ctx:scope]);
}

@LIMITER(scope [ctx:scope], int [ctx:current], int [instr:limit]) {
  scope([ctx:scope]) {
    let [ctx:current] = [instr:limit];
    run();
  }
}

@CHECK_LIMIT(scope [ctx:scope], int [ctx:current]) {
  [ctx:current] = [ctx:current] - 1;
  if([ctx:current] == 0) {
    exit_scope([ctx:scope]);
  }
}

@CREATE_RESULT_STORAGE(int [ctx:storage]) {
  let [ctx:storage] = 0;
  run();
}

@ADD_RESULT_STORAGE(int [ctx:storage], int [ctx:value]) {
  [ctx:storage] = [ctx:storage] + [ctx:value];
}

@SET_RESULT_STORAGE(int [ctx:storage], int [ctx:value]) {
  [ctx:storage] = [ctx:value];
}

$for_each_list_indexed(<java.util.List> [ctx:list], yield<java.lang.Object> [ctx:element]) {
  let [local:index]<int> = 0;
  let [local:size]<int> = List_size([ctx:list]);
  while([local:index] < [local:size]) {
    yield([ctx:element], List_get([ctx:list], [local:index]));
    [local:index] = [local:index] + 1;
  }
}

$for_each_iterator(<java.util.Iterator> [ctx:iterator], yield<java.lang.Object> [ctx:element]) {
  while(Iterator_hasNext([ctx:iterator]) != false) {
    yield([ctx:element], Iterator_next([ctx:iterator]));
  }
}

$for_each_iterable(<java.lang.Iterable> [ctx:iterable], yield<java.lang.Object> [ctx:element]) {
  let [local:iterator]<java.util.Iterator> = Iterable_iterator([ctx:iterable]);
  while(Iterator_hasNext([local:iterator]) != false) {
    yield([ctx:element], Iterator_next([local:iterator]));
  }
}

