{
  "schemaVersion": 1,
  "id": "minecraftfunctioncompiler",
  "version": "${version}",
  "name": "Function Compiler",
  "icon": "assets/minecraftfunctioncompiler/icon.png",
  "description": "This mod allows the server to automatically compile most of the functions to Java bytecode",
  "authors": [ "EpicPix" ],
  "license": "LGPL-3.0-only",
  "environment": "*",
  "accessWidener": "minecraftfunctioncompiler.accesswidener",
  "entrypoints": {
    "main": [
      "dev.epicpix.minecraftfunctioncompiler.v26_1.FunctionCompilerMain"
    ]
  },
  "mixins": [
    "minecraftfunctioncompiler.mixins.json"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/mcfc",
    "sources": "https://gitlab.epicpix.dev/EpicPix/MinecraftFunctionCompiler",
    "issues": "https://gitlab.epicpix.dev/EpicPix/MinecraftFunctionCompiler/-/issues",
    "email": "epicpix@epicpix.dev"
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~26.1-"
  }
}
