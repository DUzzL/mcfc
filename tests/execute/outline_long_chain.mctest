; One execute chain far over the JIT method size limit: the compiler moves chain tails into separate methods.
; Conditions, context modifiers (positioned/rotated/anchored/as/at), store, per-source forks and macro arguments behave as one command.
@setup
objective create t dummy

@function run
scoreboard players set #go t 1
scoreboard players set hits t 0
scoreboard players set miss t 0
scoreboard players set count t 0
scoreboard players set r t -1
summon minecraft:armor_stand ~ ~10 ~ {NoGravity:1b,Tags:["mo","mo_a"]}
summon minecraft:armor_stand ~1 ~10 ~ {NoGravity:1b,Tags:["mo","mo_b"]}
summon minecraft:armor_stand ~ ~10 ~1 {NoGravity:1b,Tags:["mo","mo_c"]}
execute positioned ~ ~10 ~ if entity @e[tag=mo,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] if score #go t matches 1 unless entity @e[tag=mo_none,distance=..30] positioned ~ ~ ~ if entity @e[tag=mo_a,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] rotated ~ ~ if entity @e[type=minecraft:armor_stand,tag=mo_b,distance=..30] anchored feet if entity @e[tag=mo_c,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] unless score #go t matches 2 if entity @e[tag=mo,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] if score #go t matches 1 unless entity @e[tag=mo_none,distance=..30] positioned ~ ~ ~ if entity @e[tag=mo_a,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] rotated ~ ~ if entity @e[type=minecraft:armor_stand,tag=mo_b,distance=..30] anchored feet if entity @e[tag=mo_c,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] unless score #go t matches 2 if entity @e[tag=mo,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,tag=!mo_s,tag=!mo_r,tag=!mo_q,tag=!mo_p,tag=!mo_o,tag=!mo_n,tag=!mo_m] if score #go t matches 1 unless entity @e[tag=mo_none,distance=..30] positioned ~ ~ ~ if entity @e[tag=mo_a,distance=..30,type=minecraft:armor_stand,tag=!mo_x,tag=!mo_y,tag=!mo_z,tag=!mo_w,tag=!mo_v,tag=!mo_u,ta