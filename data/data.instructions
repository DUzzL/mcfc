  compile_match([instr:option]) {
    CLEAR {
      [static:MinecraftServer].setWeatherParameters(<net.minecraft.server.level.ServerLevel>.RAIN_DELAY.sample([static:MinecraftServer].overworld().getRandom()), 0, false, false);
    }
    RAIN {
      [static:MinecraftServer].setWeatherParameters(0, <net.minecraft.server.level.ServerLevel>.RAIN_DURATION.sample([static:MinecraftServer].overworld().getRandom()), true, false);
    }
    THUNDER {
      [static:MinecraftServer].setWeatherParameters(0, <net.minecraft.server.level.ServerLevel>.THUNDER_DURATION.sample([static:MinecraftServer].overworld().getRandom()), true, true);
    }
  }
}

