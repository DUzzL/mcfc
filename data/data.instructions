@GET_DISTANCE_SQUARED(<net.minecraft.world.phys.Vec3> [ctx:position_a], <net.minecraft.world.phys.Vec3> [ctx:position_b]) -> double {
  [local:x] = [ctx:position_a].x - [ctx:position_b].x;
  [local:y] = [ctx:position_a].y - [ctx:position_b].y;
  [local:z] = [ctx:position_a].z - [ctx:position_b].z;
  return [local:x]*[local:x] + [local:y]*[local:y] + [local:z]*[local:z];
}

