EXECUTE_AT/execute at <targets:entity_selector> <command:command[root=execute]>
EXECUTE_IF_ENTITY/execute if entity <entities:entity_selector> <command:command[root=execute]>
EXECUTE_IF_SCORE_RANGE/execute if score <target:score_holder> <targetObjective:objective> matches <range:int_range> <command:command[root=execute]>
EXECUTE_IF_SCORE_COMPARE/execute if score <target:score_holder> <targetObjective:objective> <comparison:score_comparison> <source:score_holder> <sourceObjective:objective> <command:command[root=execute]>
EXECUTE_ROTATED_AS/execute rotated as <targets:entity_selector> <command:command[root=execute]>
EXECUTE_ROTATED_ROT/execute rotated <rot:rotation> <command:command[root=execute]>
EXECUTE_RUN/execute run <command:command>
EXECUTE_POSITIONED_AS/execute positioned as <targets:entity_selector> <command:command[root=execute]>
EXECUTE_POSITIONED_POS/execute positioned <pos:vec3> <command:command[root=execute]>
EXECUTE_STORE_RESULT_SCORE/execute store result score <targets:score_holder> <objective:objective> <command:command[root=execute]>
EXECUTE_UNLESS_ENTITY/execute unless entity <entities:entity_selector> <command:command[root=execute]>
EXECUTE_UNLESS_SCORE_RANGE/execute unless score <target:score_holder> <targetObjective:objective> matches <range:int_range> <command:command[root=execute]>
EXECUTE_UNLESS_SCORE_COMPARE/execute unless score <target:score_holder> <targetObjective:objective> <comparison:score_comparison> <source:score_holder> <sourceObjective:objective> <command:command[root=execute]>
FUNCTION/function <functions:function>
GAMEMODE/gamemode <gamemode:gamemode> <targets:entity_selector[players]:self>
KILL/kill <targets:entity_selector:self>
SCOREBOARD_PLAYERS_ADD/scoreboard players add <targets:score_holder> <objective:objective> <score:int[minimum=0]>
SCOREBOARD_PLAYERS_GET/scoreboard players get <targets:score_holder> <objective:objective>
SCOREBOARD_PLAYERS_OPERATION/scoreboard players operation <targets:score_holder> <targetObjective:objective> <operation:scoreboard_operation> <source:score_holder> <sourceObjective:objective>
