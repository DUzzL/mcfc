LOOT_GIVE_FISH/loot give <players:entity_selector[players]> fish <loot_table:resource_location> <pos:block_pos>
LOOT_GIVE_MINE/loot give <players:entity_selector[players]> mine <pos:block_pos> <tool:block_predicate>
LOOT_GIVE_MINE_MAINHAND/loot give <players:entity_selector[players]> mine <pos:block_pos> mainhand
LOOT_GIVE_MINE_OFFHAND/loot give <players:entity_selector[players]> mine <pos:block_pos> offhand

# execute if дополнительные subcommands
EXECUTE_IF_PREDICATE/execute if predicate <predicate:loot_predicate> <command:command[root=execute]>
EXECUTE_UNLESS_PREDICATE/execute unless predicate <predicate:loot_predicate> <command:command[root=execute]>
EXECUTE_IF_BLOCKS/execute if blocks <start:block_pos> <end:block_pos> <destination:block_pos> all <command:command[root=execute]>
EXECUTE_IF_BLOCKS_MASKED/execute if blocks <start:block_pos> <end:block_pos> <destination:block_pos> masked <command:command[root=execute]>
EXECUTE_UNLESS_BLOCKS/execute unless blocks <start:block_pos> <end:block_pos> <destination:block_pos> all <command:command[root=execute]>
EXECUTE_UNLESS_BLOCKS_MASKED/execute unless blocks <start:block_pos> <end:block_pos> <destination:block_pos> masked <command:command[root=execute]>
EXECUTE_IF_SCORE_RANGE_ONLY/execute if score <target:score_accessor[single]> matches <range:int_range>
EXECUTE_UNLESS_SCORE_RANGE_ONLY/execute unless score <target:score_accessor[single]> matches <range:int_range>
EXECUTE_IF_ENTITY_ONLY/execute if entity <entities:entity_selector>
EXECUTE_UNLESS_ENTITY_ONLY/execute unless entity <entities:entity_selector>
EXECUTE_UNLESS_BIOME/execute unless biome <pos:block_pos> <biome:resource_location> <command:command[root=execute]>
EXECUTE_IF_DIMENSION/execute if dimension <dimension:resource_location> <command:command[root=execute]>
EXECUTE_UNLESS_DIMENSION/execute unless dimension <dimension:resource_location> <command:command[root=execute]>
EXECUTE_IF_LOADED/execute if loaded <pos:block_pos> <command:command[root=execute]>
EXECUTE_UNLESS_LOADED/execute unless loaded <pos:block_pos> <command:command[root=execute]>

# Одиночный селектор relaxed — @e[limit=1,sort=arbitrary] как single

EXECUTE_SUMMON/execute summon <entity:resource_location> <command:command[root=execute]>
EXECUTE_POSITIONED_OVER/execute positioned over <heightmap:word> <command:command[root=execute]>

ITEM_REPLACE_ENTITY_WITH/item replace entity <targets:entity_selector> <slot:slot_source> with <item:greedy_string[macros]>
ITEM_REPLACE_ENTITY_FROM_ENTITY_SLOT/item replace entity <targets:entity_selector> <slot:slot_source> from entity <source:entity_selector> <source_slot:slot_source>
ITEM_REPLACE_BLOCK_WITH/item replace block <pos:block_pos> <slot:slot_source> with <item:greedy_string[macros]>
ITEM_REPLACE_BLOCK_FROM_ENTITY_SLOT/item replace block <pos:block_pos> <slot:slot_source> from entity <source:entity_selector> <source_slot:slot_source>
ITEM_REPLACE_BLOCK_FROM_BLOCK_SLOT/item replace block <pos:block_pos> <slot:slot_source> from block <source_pos:block_pos> <source_slot:slot_source>

# execute if/unless data (проверка NBT)
EXECUTE_IF_DATA_ENTITY/execute if data entity <target:entity_selector[single]> <path:nbt_path> <command:command[root=execute]>
EXECUTE_IF_DATA_STORAGE/execute if data storage <target:resource_location> <path:nbt_path> <command:command[root=execute]>
EXECUTE_IF_DATA_BLOCK/execute if data block <pos:block_pos> <path:nbt_path> <command:command[root=execute]>
EXECUTE_UNLESS_DATA_ENTITY/execute unless data entity <target:entity_selector[single]> <path:nbt_path> <command:command[root=execute]>
EXECUTE_UNLESS_DATA_STORAGE/execute unless data storage <target:resource_location> <path:nbt_path> <command:command[root=execute]>
EXECUTE_UNLESS_DATA_BLOCK/execute unless data block <pos:block_pos> <path:nbt_path> <command:command[root=execute]>

# execute if/unless items standalone (без команды в конце — для execute store result ... if items)
EXECUTE_IF_ITEMS_ENTITY_ONLY/execute if items entity <targets:entity_selector> <slot:slot_source> <item_predicate:block_predicate>
EXECUTE_UNLESS_ITEMS_ENTITY_ONLY/execute unless items entity <targets:entity_selector> <slot:slot_source> <item_predicate:block_predicate>
EXECUTE_IF_ITEMS_BLOCK_ONLY/execute if items block <pos:block_pos> <slot:slot_source> <item_predicate:block_predicate>
EXECUTE_UNLESS_ITEMS_BLOCK_ONLY/execute unless items block <pos:block_pos> <slot:slot_source> <item_predicate:block_predicate>

# scoreboard players display name с display name
SCOREBOARD_PLAYERS_DISPLAY_NAME_TEXT/scoreboard players display name <targets:score_holder> <objective:word> <display_name:text>
SCOREBOARD_PLAYERS_DISPLAY_NAME_GREEDY/scoreboard players display name <targets:score_holder> <objective:word> <display_name:greedy_string[macros]>
